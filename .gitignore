# Publish by allowlist. New asset types and directories require explicit review.
*
!/.gitignore
!/LICENSE
!/README.md
!/Package.swift
!/Package.resolved
!/Sources/
!/Sources/**/
!/Sources/**/*.swift
!/Sources/**/*.m
!/Sources/**/*.h
!/Tests/
!/Tests/**/
!/Tests/**/*.swift
!/Scripts/
!/Scripts/build-app.sh
!/Scripts/build-dmg.sh
!/docs/
!/docs/*.md
!/docs/assets/
!/docs/assets/evanto.png
!/Packaging/
!/Packaging/Info.plist
!/Packaging/Evanto.icns
!/Packaging/Codex/
!/Packaging/Codex/LICENSE
!/Packaging/Codex/NOTICE
!/Packaging/Fonts/
!/Packaging/Fonts/DMSans.ttf
!/Packaging/Fonts/DMSerifText.ttf
!/Packaging/Fonts/*-OFL.txt
!/Packaging/Speech/
!/Packaging/Speech/*-LICENSE
!/Packaging/Speech/NOTICE

# Ignore local and credential directories even within a source tree.
.build/
.swiftpm/
.codex/
.git-credentials
.env*
auth.json
*.p8
*.p12
*.keychain*
*.pem
*.mobileprovision
xcuserdata/
